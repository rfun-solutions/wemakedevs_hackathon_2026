{
  "name": "kubecompanion",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "KubeCompanion: offline-first, accessible conference companion",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "api",
    "web"
  ],
  "scripts": {
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "test": "vitest run --passWithNoTests",
    "build": "npm run build --workspaces --if-present",
    "start": "node app/server.js"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.65.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
